# ==============================================================================
# Vector Dynamic Website — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env.local` (or `.env`) for local development, or configure
# these variables in your production deployment dashboard (Vercel / Docker).
# Never commit real API keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Site URL & Canonical Domain
# ------------------------------------------------------------------------------
# Used for canonical URLs, OpenGraph metadata, JSON-LD structured data,
# /sitemap.xml, /robots.txt, /llms.txt, and /llms-full.txt.
NEXT_PUBLIC_SITE_URL=https://vectordynamic.com

# ------------------------------------------------------------------------------
# 2. Transactional Email & Inquiry Routing (/api/contact)
# ------------------------------------------------------------------------------
# Required in production to deliver inquiries from /contact, /audit, /book,
# /partners, and /for/[industry] via Resend (https://resend.com).
# Note: The sender domain in CONTACT_FROM_EMAIL must be verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL="Vector Dynamic <info@vectordynamic.com>"
CONTACT_TO_EMAIL="info@vectordynamic.com"

# ------------------------------------------------------------------------------
# 3. Discovery Call Calendar & Walkthrough Video Embeds (Optional)
# ------------------------------------------------------------------------------
# Cal.com or Calendly embed URL rendered on /book.
# If left empty, /book automatically renders the native Call Request form.
# Example: https://cal.com/vectordynamic/30min?embed=true
NEXT_PUBLIC_BOOKING_URL=

# Optional 2-minute engineering walkthrough embed URL (Loom / YouTube / Vimeo)
# displayed on /work/syncdaily when set.
# Example: https://www.loom.com/embed/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_DEMO_VIDEO_URL=

# ------------------------------------------------------------------------------
# 4. Analytics & Attribution (Optional)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (loaded only after explicit cookie consent).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KHBTJM0J0W

# ------------------------------------------------------------------------------
# 5. Automated SSR Smoke Test Suite (Optional — CI / Local Verification)
# ------------------------------------------------------------------------------
# Used by `npm run smoke` (scripts/smoke-ssr.mjs) to verify all 38 SSR routes.
SMOKE_PORT=3105
# SMOKE_BASE_URL=http://127.0.0.1:3105
